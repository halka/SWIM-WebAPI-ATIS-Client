{
  "name": "swim-webapi-atis",
  "version": "2.0.0",
  "description": "TypeScript client for Japan MLIT SWIM ATIS Information Request Service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "openapi.yml"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test src/**/*.test.ts",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "swim",
    "atis",
    "mlit",
    "aviation",
    "air-traffic-services",
    "japan"
  ],
  "author": "halka",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
